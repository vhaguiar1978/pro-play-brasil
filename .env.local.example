# ─── OBRIGATÓRIO (sem isso, nada de auth/dados em prod) ─────────────

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NUNCA expor pro client. Mesma página de API do Supabase.
# Quando setada, todos os storages migram pra Supabase automaticamente
# (sem ela, fica usando filesystem local — só funciona em dev).
SUPABASE_SERVICE_ROLE_KEY=

# E-mails autorizados a acessar /admin, separados por vírgula.
ADMIN_EMAILS=

# URL pública do site (sem barra no fim). Usada nos links de e-mail.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── OPCIONAIS ──────────────────────────────────────────────────────

# Cron secret pro endpoint /api/cron/auto-confirm-matches.
# Gera com: openssl rand -hex 32
# Sem isso, o endpoint fica aberto (ok pra dev, NÃO ok pra prod).
CRON_SECRET=

# Resend pra push de notificações por e-mail (eventos críticos).
# Sem essas envs, notificações ficam só in-site (sino).
RESEND_API_KEY=
EMAIL_FROM="Pro Play Brasil <no-reply@seu-dominio.com>"

# ─── INTEGRAÇÕES (ainda não obrigatórias) ───────────────────────────

MERCADO_PAGO_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ADMIN_WHATSAPP_TO=
TWILIO_WHATSAPP_CONTENT_SID=
